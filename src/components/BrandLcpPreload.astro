---
import type { CompanyConfig } from '../lib/companyConfig';
import {
  companyHeaderWordmarkImageUrl,
  companyHeaderWordmarkInlineSvg,
} from '../lib/companyConfig';

interface Props {
  company: CompanyConfig;
}

const { company } = Astro.props;
const inlineLogoSvg = companyHeaderWordmarkInlineSvg(company);
const wordmarkUrl = inlineLogoSvg ? '' : companyHeaderWordmarkImageUrl(company);
---

{
  wordmarkUrl ? (
    <link rel="preload" as="image" href={wordmarkUrl} fetchpriority="high" />
  ) : null
}
