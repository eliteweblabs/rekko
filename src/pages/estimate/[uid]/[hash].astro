---
/**
 * /estimate/:uid/:hash — Client e-sign for a Crater estimate (Option A).
 */
import { getContact, extractPortal } from '../../../lib/contactApi';
import { getCompanyConfig } from '../../../lib/companyConfig';
import { DOCUMENT_BRAND_MARK_CSS } from '../../../lib/documentPrintLayout';
import Header from '../../../components/Header.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Favicon from '../../../components/Favicon.astro';
import ViewportMeta from '../../../components/ViewportMeta.astro';
import { hasDigitalSignature } from '../../../lib/features';
import {
  craterGetEstimateByHash,
  isCraterConfigured,
  type CraterEstimateSignPayload,
} from '../../../lib/craterClient';
import { renderEstimateSignHtml } from '../../../lib/estimateSignHtml';
import '../../../styles/brand.css';

const company = await getCompanyConfig(Astro.request);
const { uid, hash: uniqueHash } = Astro.params;

let error: string | null = null;
let filled = '';
let title = '';
let contactName = '';
let alreadySignedUrl: string | null = null;
let payload: CraterEstimateSignPayload | null = null;

if (!uid || !uniqueHash) {
  error = 'Invalid link.';
} else if (!hasDigitalSignature()) {
  error = 'Electronic signing is not available on this site.';
} else if (!isCraterConfigured()) {
  error = 'Billing is not configured.';
} else {
  const contactRes = await getContact(uid);
  if (!contactRes.ok) {
    error = 'This link is no longer valid.';
  } else if (contactRes.data.archived) {
    error = 'This link is no longer valid.';
  } else {
    const portal = extractPortal(contactRes.data);
    if (portal?.enabled === false) {
      error = 'This link is no longer valid.';
    } else {
      contactName = contactRes.data.name;
      const existing = (portal?.documents ?? []).find((d) => d.estimateUniqueHash === uniqueHash);
      if (existing) {
        alreadySignedUrl = `${Astro.url.origin}/doc/${encodeURIComponent(uid)}/view/${existing.id}`;
      }

      const craterRes = await craterGetEstimateByHash(uniqueHash, uid);
      if (!craterRes.ok) {
        error =
          craterRes.status === 410
            ? 'This estimate has expired or was rejected.'
            : 'This estimate could not be loaded.';
      } else {
        payload = craterRes.data.payload;
        if (payload.estimate.signature_view_url && payload.estimate.status === 'ACCEPTED') {
          alreadySignedUrl = payload.estimate.signature_view_url;
        }
        title = `Estimate ${payload.estimate.estimate_number}`;
        filled = renderEstimateSignHtml(payload);
      }
    }
  }
}

if (error) Astro.response.status = 404;

const canSign = !error && !alreadySignedUrl;
const signEndpoint = `/api/estimate/${encodeURIComponent(uid ?? '')}/sign`;
const siteBase = Astro.url.origin;
const pageTitle = error ? 'Not found' : canSign ? `${title} — Sign` : title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ViewportMeta />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <Favicon />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    {error ? (
      <main class="error-wrap">
        <h1>This link isn't available</h1>
        <p>{error}</p>
      </main>
    ) : (
      <main>
        <div class="doc-header">
          <div class="logo print-only">{company.name}</div>
          <div class="doc-header-text">
            <div class="doc-title">{title}</div>
            <div class="doc-for">Prepared for {contactName}</div>
          </div>
        </div>

        <div class="doc-body" set:html={filled} />

        {alreadySignedUrl ? (
          <div class="already-signed-section">
            <div class="sign-divider"></div>
            <div class="already-signed-icon">✓</div>
            <h2>Already signed</h2>
            <p>This estimate has already been signed. Your signed copy is available below.</p>
            <a class="view-btn" href={alreadySignedUrl}>View &amp; Download PDF →</a>
          </div>
        ) : (
          <div class="sign-section" id="sign-section">
            <div class="sign-divider"></div>
            <h2 class="sign-heading">Sign this estimate</h2>

            <div class="consent-row" id="consent-row">
              <input id="consent-check" class="consent-check" type="checkbox" aria-required="true" />
              <label for="consent-check" class="consent-label">
                I agree to conduct this transaction electronically and use an electronic signature
                in place of a handwritten signature. I understand this is legally binding.
              </label>
            </div>

            <label class="sign-label" for="signer-name">Full name</label>
            <input
              id="signer-name"
              class="sign-input"
              type="text"
              placeholder="e.g. John Smith"
              autocomplete="name"
              autocorrect="off"
            />

            <div class="sign-date" id="sign-date-display"></div>

            <button class="sign-btn" id="sign-btn" type="button" disabled>Sign &amp; Agree</button>

            <p class="sign-legal">
              Signed electronically via {company.name} · {siteBase}
            </p>
          </div>
        )}

        <div class="success-section" id="success-section" style="display:none">
          <div class="success-icon">✓</div>
          <h2>Estimate signed</h2>
          <p>Thank you, <strong id="signer-display"></strong>. Your signed copy has been saved.</p>
          <a class="view-btn" id="view-link" href="#">View &amp; Download PDF →</a>
        </div>

        <SiteFooter tone="light" />
      </main>
    )}

    <script define:vars={{ signEndpoint, uniqueHash }}>
      const nameInput = document.getElementById('signer-name');
      const consentCheck = document.getElementById('consent-check');
      const signBtn = document.getElementById('sign-btn');
      const signSection = document.getElementById('sign-section');
      const successSection = document.getElementById('success-section');
      const signerDisplay = document.getElementById('signer-display');
      const viewLink = document.getElementById('view-link');
      const dateDisplay = document.getElementById('sign-date-display');

      if (dateDisplay) {
        dateDisplay.textContent = new Date().toLocaleString('en-US', {
          dateStyle: 'long',
          timeStyle: 'short',
        });
      }

      function updateBtn() {
        if (!signBtn || !nameInput) return;
        const nameOk = nameInput.value.trim().length >= 2;
        const consentOk = consentCheck ? consentCheck.checked : false;
        signBtn.disabled = !(nameOk && consentOk);
      }

      nameInput?.addEventListener('input', updateBtn);
      consentCheck?.addEventListener('change', updateBtn);

      signBtn?.addEventListener('click', async () => {
        const name = nameInput?.value.trim() ?? '';
        if (name.length < 2 || !consentCheck?.checked) return;

        signBtn.disabled = true;
        signBtn.textContent = 'Saving…';

        try {
          const res = await fetch(signEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              uniqueHash,
              signerName: name,
              consentChecked: true,
            }),
          });
          const json = await res.json();

          if (res.status === 409 && json.alreadySigned) {
            if (signSection) signSection.style.display = 'none';
            if (viewLink) viewLink.href = json.viewUrl;
            if (signerDisplay) signerDisplay.textContent = name;
            if (successSection) successSection.style.display = '';
            return;
          }

          if (!res.ok || !json.ok) throw new Error(json.error || 'Sign failed');

          if (signerDisplay) signerDisplay.textContent = name;
          if (viewLink) viewLink.href = json.viewUrl;
          if (signSection) signSection.style.display = 'none';
          if (successSection) successSection.style.display = '';
        } catch {
          signBtn.disabled = false;
          signBtn.textContent = 'Sign & Agree';
          alert('Something went wrong. Please try again.');
        }
      });
    </script>

    <style is:global set:html={DOCUMENT_BRAND_MARK_CSS}></style>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html, body {
        margin: 0;
        min-height: 100%;
        background: #fff;
        color: #1a1a1a;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, Georgia, serif;
        font-size: 16px;
        line-height: 1.7;
      }
      main {
        max-width: 780px;
        margin: 0 auto;
        padding:
          calc(var(--app-header-h, 3.25rem) + 24px)
          32px
          calc(48px + env(safe-area-inset-bottom, 0px));
      }
      .doc-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 40px;
        padding-bottom: 24px;
        border-bottom: 2px solid #1a1a1a;
      }
      .logo { font-weight: 800; letter-spacing: 2px; font-size: 20px; }
      .doc-title { font-size: 18px; font-weight: 700; }
      .doc-for { font-size: 14px; color: #666; }
      .doc-body { margin-bottom: 56px; }
      .sign-divider { height: 2px; background: #1a1a1a; margin-bottom: 40px; }
      .sign-heading { font-size: 22px; font-weight: 700; margin: 0 0 20px; }
      .consent-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #f8f8f6;
        border: 1px solid #d8d8d0;
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 24px;
      }
      .consent-label { font-size: 14px; color: #333; cursor: pointer; }
      .sign-label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px; }
      .sign-input {
        width: 100%;
        max-width: 420px;
        padding: 12px 14px;
        font-size: 16px;
        border: 1px solid #ccc;
        border-radius: 8px;
        margin-bottom: 12px;
      }
      .sign-date { font-size: 13px; color: #888; margin-bottom: 24px; }
      .sign-btn {
        display: inline-block;
        padding: 14px 28px;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        background: #1a1a1a;
        border: none;
        border-radius: 8px;
        cursor: pointer;
      }
      .sign-btn:disabled { opacity: 0.45; cursor: not-allowed; }
      .sign-legal { font-size: 12px; color: #999; margin-top: 16px; }
      .view-btn {
        display: inline-block;
        margin-top: 8px;
        padding: 12px 20px;
        background: #1a1a1a;
        color: #fff;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
      }
      .already-signed-section,
      .success-section { text-align: center; padding: 48px 24px 56px; }
      .already-signed-icon,
      .success-icon {
        font-size: 28px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #1a1a1a;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
      }
      .error-wrap { max-width: 480px; margin: 120px auto; padding: 0 24px; text-align: center; }
    </style>
  </body>
</html>
